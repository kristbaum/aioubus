# Shared settings for lab.sh and fakedevs.sh. Every value can be overridden
# from the environment, e.g. `LAB_NET=10.99.0 ./real_test/lab.sh up`.

OPENWRT_VERSION="${OPENWRT_VERSION:-25.12.5}"

# LAN subnet between host and VM. Deliberately not 192.168.1.x so it cannot
# collide with a real OpenWrt router on the host's network.
LAB_NET="${LAB_NET:-192.168.77}"
ROUTER="${ROUTER:-$LAB_NET.1}"
HOST_IP="${HOST_IP:-$LAB_NET.2}"
BRIDGE="${BRIDGE:-br-owrt}"
TAP="${TAP:-tap-owrt}"

# Throwaway credentials; the VM is only reachable from this host.
ROOT_PASSWORD="${ROOT_PASSWORD:-testlab-root}"
ACL_USER="${ACL_USER:-hass}"
ACL_PASSWORD="${ACL_PASSWORD:-testlab-hass}"

SSID="${SSID:-testnet}"
PSK="${PSK:-testtest}"

# Working files (image, pid, serial log). Gitignored.
LAB_DIR="${LAB_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/.lab}"
